{
  "name": "acryl-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "catalog:sync": "pnpm catalog:sync:dsh && pnpm catalog:sync:acryl",
    "catalog:sync:dsh": "node scripts/sync-upstream-catalog.mjs",
    "catalog:sync:acryl": "node scripts/sync-acryl-catalog.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.2.10",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "vitest": "3.0.5"
  }
}
